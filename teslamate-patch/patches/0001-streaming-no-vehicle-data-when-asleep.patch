@@ -602,6 +602,23 @@ defmodule TeslaMate.Vehicles.Vehicle do
 
   #### Online
 
+  # PATCH (sindrema): the upstream code has no :online handler for {:stream, :inactive},
+  # so a car that goes :online (real drive) and then parks/sleeps — making the stream go
+  # quiet — has NO way out of :online and retries the billable vehicle_data endpoint every
+  # ~20s forever (it answers 408 while asleep). When the stream goes inactive in :online,
+  # the car has stopped streaming, i.e. gone to sleep: drop the stream and re-evaluate from
+  # :start (cheap listing + stream probe), which now lands back in asleep without polling.
+  def handle_event(:info, {:stream, :inactive}, :online, %Data{} = data) do
+    Logger.info("Online / Stream inactive — car stopped streaming, re-evaluating from start",
+      car_id: data.car.id
+    )
+
+    :ok = disconnect_stream(data)
+
+    {:next_state, :start, %Data{data | pre_online_check: :idle, stream_pid: nil},
+     [broadcast_fetch(false), broadcast_summary(), schedule_fetch(0, data)]}
+  end
+
   def handle_event(:info, {:stream, %Stream.Data{} = stream_data}, :online, data) do
